# Copy to .env.local and fill in. Never commit real values.

# --- Sign-in (GitHub OAuth app; callback URL: <site>/api/auth/callback/github)
AUTH_SECRET=            # `npx auth secret` generates one
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# AUTH_URL=https://stagedirector.example.com   # needed behind a proxy

# --- Dashboard's own GitHub identity (reads status, starts runs, records approvals)
# Preferred: a GitHub App installed on the project repos with permissions
#   Actions: read & write, Contents: read, Deployments: read & write,
#   Pull requests: read, Metadata: read, Members (org): read
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=   # PEM; "\n" escapes are accepted
GITHUB_APP_INSTALLATION_ID=
# Or, for local testing, a fine-grained token with the same permissions:
GITHUB_TOKEN=

# --- Projects shown on the dashboard (repos with a stagedirector.yml)
STAGEDIRECTOR_REPOS=owner/repo,owner/other-repo

# --- Local development only: act as this GitHub login without OAuth (ignored in production)
# STAGEDIRECTOR_DEV_LOGIN=your-login

# --- "What this update does" summaries (optional). Without a key the PR's own text is used.
# ANTHROPIC_API_KEY=
# STAGEDIRECTOR_SUMMARY_MODEL=claude-sonnet-5-5
# --- Checks (stagedirector.yml `checks:`) on password-protected stages: host=user:pass, comma-separated
# STAGEDIRECTOR_CHECK_AUTH=staging.example.com=user:pass
