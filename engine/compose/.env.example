# Copy to .env next to docker-compose.yml. One .env = one runner. Never commit .env.

# Compose project name: makes container, volume and network names unique on this host.
# Use one per runner, e.g. sd-runner-mariasplace, sd-runner-meru.
COMPOSE_PROJECT_NAME=sd-runner-example

# Repo (or org) the runner serves.
GITHUB_URL=https://github.com/<owner>/<repo>
# Shown in GitHub > Settings > Actions > Runners.
RUNNER_NAME=<host>-<project>
# Must include the `runner:` label used in the project's stagedirector.yml.
RUNNER_LABELS=self-hosted,<host-label>

# Registration token, only for the first start (Settings > Actions > Runners > New
# self-hosted runner; valid 1 hour). Delete it after the log says "registered".
RUNNER_TOKEN=

# Resource caps so jobs cannot starve the sites on this host.
RUNNER_MEMORY=900m
RUNNER_CPUS=1.0

# Folder with an ssh `config` (host aliases) and `known_hosts`. No private keys here: the
# workflow loads them from the GitHub Environment secret STAGEDIRECTOR_SSH_KEY.
SSH_CONFIG_DIR=./ssh

# Pinned tool versions. GitHub refuses to register runners that are too old (config.sh
# fails with "404 Not Found" at GetTenantCredential): use a current release from
# https://github.com/actions/runner/releases and rebuild.
RUNNER_VERSION=2.338.2
WRANGLER_VERSION=3.99.0

# Optional Ubuntu mirror for the image build. On OVH hosts (ovh1) Canonical's archive can time
# out and apt-get update hangs; use http://ubuntu.mirrors.ovh.net/ubuntu/ there.
APT_MIRROR=

# Only with docker-socket.yml: the host's docker group id (getent group docker | cut -d: -f3).
# DOCKER_GID=

# Headless Chromium for review screenshots (~350 MB more image). false = no screenshots from this runner.
WITH_BROWSER=true
