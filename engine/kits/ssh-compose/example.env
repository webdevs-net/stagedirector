# /etc/stagedirector/<project>-<stage>.env  (owned by root, mode 644). Plain KEY=value; never executed.
# Example: Meru staging next to live on vultr1. <...> are placeholders.

# Own Compose project: own containers, networks and named volumes. Must differ from live's.
COMPOSE_PROJECT_NAME=meru-stg-pipeline
# This key may never touch these projects (live's), even if the name above is mistyped.
PROTECTED_PROJECTS=meru-pipeline,meru-mautic,meru-mautic-local
# Git checkout used only by this stage (read-only GitHub deploy key on the host).
APP_DIR=/opt/stg-meru/repo
# Compose files, relative to APP_DIR, comma-separated (base + staging override).
COMPOSE_FILES=deploy/vultr1/docker-compose.yml,deploy/vultr1/docker-compose.staging.yml
# Env files outside git (secrets for staging only), comma-separated, absolute paths.
ENV_FILES=/opt/stg-meru/.env
HEALTH_TIMEOUT=120
# Host-side check run before every deploy; must exit 0 (staging mail safety for Meru).
GUARD=/usr/local/bin/meru-staging-mail-guard
