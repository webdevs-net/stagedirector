# /opt/stg-meru/.env on vultr1 (never commit). Staging-only values; NONE may be live's.
STAGING_SENDGW_DIR=/opt/stg-meru/sendgw          # own domains.json (copy of live's, daily_cap lowered)
STAGING_MAUTIC_NETWORK=stg-meru-mautic_default
STAGING_SERVICE_MEMORY=384m
STAGING_SERVICE_CPUS=0.5
STAGING_PIPELINE_PORT=58188
STAGING_SENDGW_ADMIN_PORT=58195
CONFIRM_BASE_URL=http://<tailnet-ip>:58188
# Mautic staging DB container, for the guard's contact check.
STAGING_MAUTIC_DB=stg-meru-mautic-db-1
STAGING_MAUTIC_TABLE_PREFIX=
# Same addresses as live's internal test list (GATEWAY_CAP_EXEMPT_RECIPIENTS in
# /opt/meru-pipeline/.env). Copy them at setup; the guard refuses anything outside that set.
GATEWAY_RECIPIENT_ALLOWLIST=<copy of live GATEWAY_CAP_EXEMPT_RECIPIENTS>
STAGING_DAILY_CAP=20
GATEWAY_USER=mautic
GATEWAY_PASS=<staging-only>
PIPELINE_ADMIN_TOKEN=<staging-only>
GATEWAY_ADMIN_ADDR=0.0.0.0:2580
GATEWAY_ADMIN_TOKEN=<staging-only>
MAILGUN_WEBHOOK_SIGNING_KEY=<staging webhook's own key>
CF_ACCOUNT_ID=<account>
CF_KV_NAMESPACE_ID=<staging KV namespace id>
CF_API_TOKEN=<staging-only token, KV on the staging namespace only>
MAUTIC_ADMIN_PASSWORD=<staging Mautic>
MAUTIC_URL=http://caddy-staging:8080
DRY_RUN=true
