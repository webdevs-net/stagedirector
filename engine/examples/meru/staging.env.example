# /opt/meru-staging/.env on vultr1 (never commit). Staging-only values; NONE may be live's.
STAGING_SENDGW_DIR=/opt/meru-staging/sendgw          # own domains.json (copy of live's, daily_cap lowered)
STAGING_MAUTIC_NETWORK=meru-mautic-staging_default
STAGING_SERVICE_MEMORY=384m
STAGING_SERVICE_CPUS=0.5
STAGING_PIPELINE_PORT=58188
STAGING_SENDGW_ADMIN_PORT=58195
CONFIRM_BASE_URL=http://<tailnet-ip>:58188
GATEWAY_RECIPIENT_ALLOWLIST=<owner-test-1@example.com>,<owner-test-2@example.com>
GATEWAY_CAP_EXEMPT_RECIPIENTS=
GATEWAY_USER=mautic
GATEWAY_PASS=<staging-only>
PIPELINE_ADMIN_TOKEN=<staging-only>
GATEWAY_ADMIN_ADDR=0.0.0.0:2580
GATEWAY_ADMIN_TOKEN=<staging-only>
MAILGUN_WEBHOOK_SIGNING_KEY=<staging webhook's own key>
CF_ACCOUNT_ID=<account>
CF_KV_NAMESPACE_ID=<staging KV namespace id>
CF_API_TOKEN=<staging-only token, KV on the staging namespace only>
MAUTIC_ADMIN_PASSWORD=<staging Mautic>
MAUTIC_URL=http://caddy-staging:8080
DRY_RUN=true
