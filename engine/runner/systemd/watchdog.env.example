# Copy to /etc/stagedirector/watchdog.env (chmod 600, owned by root).
SD_CONTAINER=stagedirector-runner-runner-1
SD_REPO=netdevs-net/MariasPlace
SD_RUNNER_NAME=ovh1-mariasplace
# Optional: fine-grained token with "Administration: read" on the repo only. Leave empty to check Docker health only.
SD_GH_TOKEN=
