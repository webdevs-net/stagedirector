+# approval_ok deploy|rollback: true when STAGEDIRECTOR_APPROVAL is a valid Stage Director approval for LIVE.
+approval_ok() {
+  local f="${STAGEDIRECTOR_APPROVAL:-}"
+  { [ -n "$f" ] && [ -f "$f" ]; } || return 1
+  [ "${GITHUB_ACTIONS:-}" = true ] || die "STAGEDIRECTOR_APPROVAL is only accepted inside the Stage Director GitHub workflow."
+  command -v jq >/dev/null || die "jq is needed to read STAGEDIRECTOR_APPROVAL"
+  jq -e --arg sha "${SHA:-}" --arg act "$1" --arg now "$(date -u +%FT%TZ)" '
+      .version == 1 and .stageId == "live"
+      and (.action == $act or ($act == "rollback" and .action == "deploy"))   # Safety net undoes the approved deploy
+      and ($act == "rollback" or .commit == $sha)
+      and (.by | type == "string" and length > 0 and (ascii_downcase | startswith("claude:") | not) and (endswith("[bot]") | not))
+      and ((.requestedBy // "") | ascii_downcase | startswith("claude:") | not)
+      and (.expiresAt | type == "string") and .expiresAt > $now' "$f" >/dev/null \
+    || die "STAGEDIRECTOR_APPROVAL is not a valid, unexpired code-owner approval for $1 ${SHORT:+of $SHORT }on LIVE."
+  APPROVED_BY="$(jq -r .by "$f")"
+}
+# person_or_approval what action: a person at a terminal, or (CI) a valid Stage Director approval.
+person_or_approval() {
+  if [ -t 0 ] && [ -t 1 ]; then return 0; fi
+  if approval_ok "$2"; then NONINTERACTIVE=1; info "No terminal: using Stage Director approval by $APPROVED_BY."; return 0; fi
+  need_tty "$1"
