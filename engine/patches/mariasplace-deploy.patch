+# current_on staging|live -> "sha|deployedAt|deployedBy" of what is on that stage now (empty if unknown).
+# Reads ~/$STATE/<stage>.log ("<when> <sha> by <who> backup <ts>" and "<when> ROLLBACK <ts>"); for
+# staging, falls back to the newest staged/ marker when staging.log does not exist yet.
+current_on() {
+  remote "f=~/$STATE/$1.log; if [ -f \$f ]; then cat \$f; elif [ $1 = staging ] && [ -d ~/$STATE/staged ]; then
+      s=\$(ls -t ~/$STATE/staged | head -1); [ -z \"\$s\" ] || echo \"\$(cut -d' ' -f2 ~/$STATE/staged/\$s) \$s by unknown backup none\"; fi" \
+  | awk '$2 == "ROLLBACK" { for (i = n; i > 0; i--) if (bk[i] == $3) { n = i - 1; break } ; next }
+         $2 ~ /^[0-9a-f]{40}$/ { n++; sha[n] = $2; at[n] = $1; by[n] = "unknown"; bk[n] = ""
+           for (i = 3; i < NF; i++) { if ($i == "by") by[n] = $(i+1); if ($i == "backup") bk[n] = $(i+1) } }
+         END { if (n > 0) printf "%s|%s|%s\n", sha[n], at[n], by[n] }'
+}
