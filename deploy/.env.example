# Settings for the dashboard container. Copy to deploy/.env and fill in on the
# server. Never commit .env. Same variables as the repo's .env.example.

# --- Compose
COMPOSE_PROJECT_NAME=stagedirector
DASHBOARD_PORT=3100          # bound to 127.0.0.1 only; tailscale serve publishes it
DASHBOARD_MEMORY=512m
DASHBOARD_CPUS=0.5

# --- Sign-in (GitHub OAuth app "Stage Director"; callback <site>/api/auth/callback/github)
AUTH_SECRET=                 # `npx auth secret` generates one
AUTH_GITHUB_ID=Ov23liJNAQW9rZSh7Nyb
AUTH_GITHUB_SECRET=          # the owner creates and pastes this; never in git or chat
AUTH_URL=https://stagedirector.webdevs.net
AUTH_TRUST_HOST=true         # behind tailscale serve

# --- Dashboard's own GitHub identity (GitHub App preferred)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=      # PEM on one line with "\n" escapes
GITHUB_APP_INSTALLATION_ID=
# GITHUB_TOKEN=              # instead of the App, for testing only

# --- Projects shown on the dashboard
STAGEDIRECTOR_REPOS=netdevs-net/mariasplace
